#!/usr/bin/env bash

. scripts/check_docker_compose

if [ ! -f .env ]; then
    cp env.example .env
fi

docker compose \
    -f docker-compose.test.yaml \
    -f docker-compose.yaml \
    -f docker-compose.test-e2e.yaml \
    up \
    -d \
    --build \
    --quiet-pull \
    --scale test=0 \
    --scale test-e2e=0

docker compose \
    -f docker-compose.test.yaml \
    -f docker-compose.yaml \
    -f docker-compose.test-e2e.yaml \
    run \
    test-e2e \
    python -m unittest discover -s /opt/docs/test

EXIT_CODE=$?

docker compose \
    -f docker-compose.test.yaml \
    -f docker-compose.yaml \
    -f docker-compose.test-e2e.yaml \
    down \
    --remove-orphans

exit $EXIT_CODE
