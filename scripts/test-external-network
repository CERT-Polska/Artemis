#!/usr/bin/env bash

cd `dirname $0`/..

# Generate docker/seccomp/syd.json for the test container's seccomp profile.
python3 docker/seccomp/update_seccomp_profile.py

docker compose -f docker-compose.test.yaml build test
docker compose -f docker-compose.test.yaml up -d test-redis test-grafana
docker compose -f docker-compose.test.yaml run test python -m unittest discover test.external_network
